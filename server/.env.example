# =====================================================================
# MTX Group Retail Suite — sync server configuration
# Copy this file to `.env` and fill it in. Never commit `.env`.
# =====================================================================

# ---- HTTP ----
PORT=5599
NODE_ENV=production
# Comma-separated list of browser origins allowed to call the API, or * for any.
# Set this to the domain the app is served from, e.g. https://pos.yourdomain.com
CORS_ORIGIN=*
# Optional: also serve the app itself from this server (path relative to /server).
# With this set, the partner points the domain at Node only — no separate web host,
# no CORS. Leave empty if a web server serves the app.
# SERVE_STATIC=..

# ---- Auth ----
# REQUIRED in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=10
# PIN for the "Owner Admin" account auto-created on a brand-new (un-imported) store.
# Change it inside the app on first login.
DEFAULT_ADMIN_PIN=1234

# ---- PostgreSQL ----
# The server manages ONE database per store, named <DB_PREFIX><store>.
# With the values below that is: mtx_melora and mtx_bangeen.
STORES=melora,bangeen
DB_PREFIX=mtx_

PGHOST=127.0.0.1
PGPORT=5432
PGUSER=mtx
PGPASSWORD=change-me
PGSSL=false
# Database the setup script connects to just to run "CREATE DATABASE".
PGADMIN_DB=postgres

# Alternative to the PG* vars: a single URL. Host/port/user/password/ssl are read
# from it; the database name is still derived per store from STORES + DB_PREFIX.
# DATABASE_URL=postgres://mtx:change-me@127.0.0.1:5432/postgres
